{
	"name": "web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "varlock run -- node scripts/snapshot.mjs --soft && vite dev",
		"snapshot": "varlock run -- node scripts/snapshot.mjs",
		"build": "vite build && varlock run -- node scripts/prerender-events.mjs && varlock scan ./dist",
		"concelhos:build": "bun run scripts/build-concelhos.ts",
		"serve": "vite preview",
		"start": "vite",
		"test": "bun test",
		"check-types": "tsc --noEmit"
	},
	"varlock": {
		"loadPath": "../../",
		"filter": "#web"
	},
	"dependencies": {
		"@events-tracker/api": "workspace:*",
		"@events-tracker/ui": "workspace:*",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query": "^5.101.4",
		"better-auth": "1.7.4",
		"leaflet": "^1.9.4",
		"lucide-react": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@events-tracker/config": "workspace:*",
		"@resvg/resvg-js": "^2.6.2",
		"@types/bun": "catalog:",
		"@types/leaflet": "^1.9.22",
		"@types/node": "^26.2.0",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@varlock/vite-integration": "^1.5.4",
		"@vitejs/plugin-react": "^6.0.4",
		"aws4fetch": "^1.0.20",
		"postcss": "^8.5.24",
		"satori": "^0.33.4",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"varlock": "^1.23.0",
		"vite": "^8.1.5"
	}
}
