{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b && tsc -p tsconfig.test.json",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "varlock run -- bun run --hot src/index.ts",
		"start": "varlock run -- bun run dist/index.mjs",
		"scrape:leiriagenda": "varlock run -- bun run src/scraper/run.ts leiriagenda",
		"geocode:venues": "varlock run -- bun run src/scraper/geocode.ts",
		"test": "bun test",
		"digest": "varlock run -- bun run src/digest-cli.ts",
		"scrape": "varlock run -- bun run src/scraper/run.ts",
		"daily": "varlock run -- bun run src/scraper/daily.ts",
		"ingest:url": "varlock run -- bun run src/ingest-url.ts"
	},
	"varlock": {
		"loadPath": "../../",
		"filter": "#server,#auth"
	},
	"dependencies": {
		"@events-tracker/api": "workspace:*",
		"@events-tracker/auth": "workspace:*",
		"@events-tracker/db": "workspace:*",
		"@events-tracker/env": "workspace:*",
		"@hono/trpc-server": "^0.4.2",
		"@trpc/server": "catalog:",
		"cheerio": "^1.2.0",
		"hono": "catalog:",
		"libsql": "catalog:",
		"luxon": "^3.7.2",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@events-tracker/config": "workspace:*",
		"@types/bun": "catalog:",
		"@types/luxon": "^3.7.5",
		"drizzle-orm": "^0.45.2",
		"tsdown": "^0.22.14",
		"typescript": "catalog:",
		"varlock": "^1.23.0"
	}
}
