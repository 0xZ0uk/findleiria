{
	"extends": "@events-tracker/config/tsconfig.base.json",
	"exclude": [
		"src/**/*.test.ts",
		"src/test-helpers.ts",
		"src/test-setup.ts",
		"node_modules",
		"dist"
	],
	"compilerOptions": {
		"composite": true,
		"outDir": "dist",
		"paths": {
			"@/*": ["./src/*"]
		},
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx"
	}
}
