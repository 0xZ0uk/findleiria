{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"buildCommand": "pnpm --filter ./packages/auth env:check:production && pnpm --filter ./packages/auth build && pnpm --filter ./apps/web build",
	"installCommand": "pnpm install --frozen-lockfile",
	"outputDirectory": "apps/web/dist",
	"rewrites": [
		{
			"source": "/api/auth/:path*",
			"destination": "/api/auth?path=:path*"
		},
		{
			"source": "/evento/:slug",
			"destination": "/evento/:slug/index.html"
		},
		{
			"source": "/evento/:slug/",
			"destination": "/evento/:slug/index.html"
		},
		{
			"source": "/((?!api/|data/).*)",
			"destination": "/index.html"
		}
	],
	"headers": [
		{
			"source": "/assets/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/data/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=0, must-revalidate"
				}
			]
		},
		{
			"source": "/og/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=86400"
				}
			]
		}
	]
}
