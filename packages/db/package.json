{
	"name": "@events-tracker/db",
	"type": "module",
	"exports": {
		".": {
			"default": "./src/index.ts"
		},
		"./client": {
			"default": "./src/client.ts"
		},
		"./*": {
			"default": "./src/*.ts"
		}
	},
	"scripts": {
		"check-types": "tsc --noEmit",
		"test": "bun test",
		"db:local": "turso dev --db-file local.db",
		"db:push": "varlock run -- drizzle-kit push",
		"db:generate": "varlock run -- drizzle-kit generate",
		"db:migrate:deploy": "varlock run -- drizzle-kit migrate",
		"db:seed": "varlock run -- bun run src/seed.ts",
		"db:studio": "varlock run -- drizzle-kit studio",
		"db:migrate": "varlock run -- drizzle-kit migrate",
		"db:publish": "varlock run -- bun run src/publish-d1.ts",
		"db:migrate:remote": "varlock run -- wrangler d1 migrations apply findleiria-events --remote"
	},
	"varlock": {
		"loadPath": "../../",
		"filter": "#db"
	},
	"dependencies": {
		"@events-tracker/env": "workspace:*",
		"@libsql/client": "0.17.4",
		"drizzle-orm": "^0.45.2"
	},
	"devDependencies": {
		"@events-tracker/config": "workspace:*",
		"drizzle-kit": "^0.31.10",
		"typescript": "catalog:",
		"varlock": "^1.23.0"
	}
}
