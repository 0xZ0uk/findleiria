{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"module": "node16",
		"moduleResolution": "node16",
		"composite": false,
		"noEmit": false,
		"declaration": true,
		"declarationMap": false,
		"sourceMap": false,
		"outDir": "dist",
		"rootDir": "src"
	},
	"include": ["src/**/*.ts"],
	"exclude": ["src/**/*.test.ts", "src/test-setup.ts"]
}
