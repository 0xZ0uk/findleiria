{
	"name": "@events-tracker/auth",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"bun": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./*": {
			"types": "./src/*.ts",
			"bun": "./src/*.ts",
			"default": "./dist/*.js"
		}
	},
	"imports": {
		"#libsql-client": {
			"types": "./src/libsql-client.web.ts",
			"bun": "./src/libsql-client.node.ts",
			"default": "./dist/libsql-client.web.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"env:check:production": "NODE_ENV=production varlock load",
		"auth:generate": "varlock run -- auth generate --config ./src/auth.ts --output ./src/schema.ts --yes",
		"db:push": "varlock run -- drizzle-kit push",
		"db:generate": "varlock run -- drizzle-kit generate",
		"db:migrate": "varlock run -- drizzle-kit migrate",
		"db:studio": "varlock run -- drizzle-kit studio",
		"test": "bun test",
		"check-types": "tsc --noEmit"
	},
	"varlock": {
		"loadPath": "../../",
		"filter": "#auth"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "1.7.4",
		"@libsql/client": "0.17.4",
		"better-auth": "1.7.4",
		"drizzle-orm": "^0.45.2",
		"hono": "catalog:",
		"nodemailer": "^10.2.1"
	},
	"devDependencies": {
		"@events-tracker/config": "workspace:*",
		"@types/bun": "catalog:",
		"@types/nodemailer": "^8.0.2",
		"drizzle-kit": "^0.31.10",
		"typescript": "catalog:",
		"varlock": "^1.23.0"
	}
}
