# FindLeiria env schema: the single source of truth for every env var the code
# reads. Committed; holds no secrets. Values go in a gitignored `.env` /
# `.env.local` next to this file (or in the Vercel project env).
#
# One schema for the whole monorepo. Each package points at it from its
# package.json (`"varlock": { "loadPath": "../../", "filter": "#tag" }`), so
# `varlock run` / `varlock load` inside a package resolves, validates and injects
# only the items tagged for it (plus what they depend on).
#
#   pnpm exec varlock load                     # validate everything
#   pnpm exec varlock load --filter "#auth"    # validate one tag
#
# Tags: #server (apps/server: dev API + scraper/digest CLIs), #db (packages/db
# scripts: drizzle-kit, seed, publish), #auth (packages/auth and the Vercel
# functions in api/), #web (apps/web: vite + prerender + snapshot).
#
# Relative `file:` URLs are resolved from the running package's directory
# (apps/server, packages/db, packages/auth): all are two levels below the root.
#
# @defaultRequired=false
# @defaultSensitive=false
# @generateTsTypes(path=./env.d.ts, exposeEnv=none, importMetaEnv=none, icons=false)
# @generateTsTypes(path=./apps/web/src/env.d.ts, filter="VITE_*", exposeEnv=none, processEnv=none, icons=false)
# ---

# Runtime mode. Left unset locally (the code treats unset as "development").
# Deliberately no default here: a default would be injected into every
# `varlock run` child, and NODE_ENV=development under `vite build` ships a
# development React build. Vercel sets "production" at runtime.
# @type=enum(development, production, test)
# @tag(server, db, auth, web)
NODE_ENV=

# --- Events database (apps/server, packages/db) ----------------------------

# libSQL URL of the events database the scraper writes and the dev API reads.
# `file:../../local.db` = the repo root's local.db.
# @required @type=string(matches=regex("^(file:|libsql://|https?://|wss?://)"))
# @tag(server, db)
DATABASE_URL=file:../../local.db

# EVENTS database (not the auth database; that one is AUTH_TURSO_TOKEN).
# Token for the events client when DATABASE_URL is a remote libSQL URL. Not
# needed for `file:` URLs. The web build no longer reads it: it reads D1
# (D1_READ_API_TOKEN).
# @sensitive
# @tag(server, db)
TURSO_AUTH_TOKEN=

# --- Dev API server (apps/server) ------------------------------------------

# The web app's origin (CORS allow-list of the dev API).
# @required @type=url
# @tag(server)
CORS_ORIGIN=http://localhost:3300

# Hono dev server port (Bun reads it). 3301 avoids the common 3000/3001 clashes.
# @type=port
# @tag(server)
PORT=3301

# Keyword watchlist for the digest CLI (comma-separated, case-insensitive);
# matching events are star-marked in `pnpm --filter server digest`.
# @example="tattoo,jazz,fado,rock"
# @tag(server)
DIGEST_KEYWORDS=

# How many scraper sources may be in their network phase at once (default 3 when
# unset). Sources hit different hosts and each keeps its own polite delay; the
# database writes stay strictly serial, in registry order. 1 = fully sequential.
# @type=number(min=1, max=16, isInt=true)
# @example=3
# @tag(server)
SCRAPE_CONCURRENCY=

# --- Publish to D1 (packages/db `db:publish`) ------------------------------

# Cloudflare account that owns the `findleiria-events` D1 database
# (dashboard URL, or `wrangler whoami`). db:publish and the web build need it;
# wrangler reads it too (`db:migrate:remote`).
# @type=string(matches=regex("^[0-9a-f]{32}$"))
# @example="0123456789abcdef0123456789abcdef"
# @tag(db, web)
CLOUDFLARE_ACCOUNT_ID=

# Id (uuid) of the `findleiria-events` D1 database db:publish mirrors local.db
# into and the web build reads the snapshot from (`wrangler d1 info
# findleiria-events`).
# @type=string(matches=regex("^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"))
# @example="00000000-0000-0000-0000-000000000000"
# @tag(db, web)
EVENTS_D1_ID=

# Cloudflare API token with D1 EDIT permission, for db:publish only (keep it on
# the cron machine). The build gets a separate read-only D1 token
# (D1_READ_API_TOKEN).
# @sensitive
# @tag(db)
D1_RW_API_TOKEN=

# Workers Builds deploy hook db:publish POSTs after D1 commits, so new events
# reach the static site. Without it the site keeps serving its last build.
# Workers & Pages > findleiria > Settings > Build > Deploy Hooks (the URL is
# https://api.cloudflare.com/client/v4/workers/builds/deploy_hooks/<id>; it
# needs no other credential). Anyone with it can trigger builds.
# @sensitive @type=url(allowedProtocols=[https])
# @tag(db)
DEPLOY_HOOK_URL=

# --- Web build (apps/web) --------------------------------------------------

# The database `pnpm dev` / `pnpm --filter web snapshot` reads (defaults to the
# repo's local.db). A `file:` URL here also makes `pnpm --filter web build`
# read that SQLite file instead of D1.
# @type=string(matches=regex("^(file:|libsql://|https?://|wss?://)"))
# @example="file:/abs/path/other.db"
# @tag(web)
SNAPSHOT_DATABASE_URL=

# Cloudflare API token with D1 READ permission only, for the web build: it
# reads the events snapshot from D1 over the REST API (CLOUDFLARE_ACCOUNT_ID +
# EVENTS_D1_ID + this). Server-side name on purpose: never VITE_-prefixed, or
# Vite would inline it into the bundle (the build also fails if it shows up
# there). Unset with a `file:` SNAPSHOT_DATABASE_URL for a local build.
# @sensitive
# @tag(web)
D1_READ_API_TOKEN=

# Cloudflare Web Analytics site token (Web Analytics > Manage site), inlined
# into the browser bundle (public by design). Also gates the custom-event
# beacon to /api/track; empty ships no third-party script and sends nothing.
# @public
# @tag(web)
VITE_CF_BEACON_TOKEN=

# --- Build cache (R2) --------------------------------------------------------
# The prerender step keeps its rendered OG cards in an R2 bucket between builds
# (apps/web/scripts/og-r2.mjs), over R2's S3-compatible API. All four unset =
# every build renders every card (a cold build, never a failed one). Create an
# R2 API token scoped to this one bucket (Object Read & Write); these values
# are build-time only and never reach the client bundle.

# Cloudflare account ID; the S3 endpoint is https://<id>.r2.cloudflarestorage.com.
# @tag(web)
R2_ACCOUNT_ID=

# @sensitive
# @tag(web)
R2_ACCESS_KEY_ID=

# @sensitive
# @tag(web)
R2_SECRET_ACCESS_KEY=

# Bucket holding `og-cards/v<N>/<key>.png`.
# @tag(web)
R2_BUILD_CACHE_BUCKET=

# --- Auth (packages/auth, api/*.ts on Vercel, the dev API) ------------------
# A second database, separate from the events data: the build publishes the
# events DB as a public snapshot, so user emails and sessions never live there.

# Dev/test only: libSQL URL of the auth database, a `file:` path (Bun dev server,
# tests, drizzle-kit). Production runs on Cloudflare D1 through the `AUTH_DB`
# binding (wrangler.jsonc), so this is neither required nor read there.
# @type=string(matches=regex("^(file:|libsql://|https?://|wss?://)"))
# @tag(server, auth)
AUTH_DATABASE_URL=file:../../local-auth.db

# Dev only: token for a remote libSQL AUTH_DATABASE_URL (not the events
# database, whose token is TURSO_AUTH_TOKEN). Not read in production.
# @sensitive
# @tag(server, auth)
AUTH_TURSO_TOKEN=

# Signs session cookies. 32+ chars; rotating it signs everyone out.
# Generate with: openssl rand -base64 48
# @required @sensitive @type=string(minLength=32)
# @tag(server, auth)
BETTER_AUTH_SECRET=

# Public origin of the app. Callback URLs and the trusted-origin list are built
# from it, so it must be exactly what the browser types.
# @required @type=url
# @tag(server, auth)
BETTER_AUTH_URL=http://localhost:3300

# Extra trusted origins, comma-separated. Loopback aliases are already added
# outside production; use this for LAN addresses and Vercel previews.
# @example="https://findleiria-git-branch-0x81d1.vercel.app"
# @tag(server, auth)
AUTH_TRUSTED_ORIGINS=

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# @required
# @tag(server, auth)
GOOGLE_CLIENT_ID=

# @required @sensitive
# @tag(server, auth)
GOOGLE_CLIENT_SECRET=

# Sender of the verification mail (Cloudflare Email Sending, `send_email`
# binding). The domain must be onboarded to Email Sending. Required when
# NODE_ENV=production; elsewhere the verification link is printed to the console
# instead of sent.
# @required=eq($NODE_ENV, "production")
# @example="FindLeiria <no-reply@findleiria.pt>"
# @tag(server, auth)
MAIL_FROM=
